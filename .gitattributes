# Fixed line endings per file type: build.sh and bench.sh must stay LF even when Git on Windows
# converts to CRLF (core.autocrlf), or Bash would fail on them after cloning on Linux or macOS.
* text=auto
*.sh   text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.pro  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf
*.jpg  binary
*.png  binary
*.jks  binary
