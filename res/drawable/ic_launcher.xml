<?xml version="1.0" encoding="utf-8"?>
<!-- Icon: a white feather on a dark violet circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp" />
            <gradient android:type="radial" android:gradientRadius="40dp"
                android:centerX="0.7" android:centerY="0.25"
                android:startColor="#FF5B3FE0" android:endColor="#FF0B0820" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_feather"
        android:left="11dp" android:right="11dp" android:top="11dp" android:bottom="11dp" />
</layer-list>
